>\n                                    <tr>\n                                        <th>Link</th>\n                                        {/* <th>Attribute Type</th> */}\n                                        <th>Link Description</th>\n                                    </tr>\n                                </thead>\n                                <tbody>\n                                    {\n                                        ontologyData[key]['Properties'].map((class_attr) => {\n                                            return (\n                                                <tr>\n                                                    <td>{class_attr['Property']}</td>\n                                                    {/* <td>{class_attr['Property Type']}</td> */}\n                                                    <td>{class_attr['Property Description']}</td>\n                                                </tr>)\n                                        })\n                                    }\n                                </tbody>\n                            </Table>\n                            <br />\n                        </Container>\n                    ):(\n                        <div />\n                    )}\n                </Container>\n            )\n        })\n    );\n};\n\nexport default StrategyGraphPanel;",["74","75"],"/Users/adeelansari/Documents/adeel-ansari.github.io/src/components/Tabview/ExampleView.js",[],"/Users/adeelansari/Documents/adeel-ansari.github.io/src/components/Tabview/CascadeView.js",[],"/Users/adeelansari/Documents/adeel-ansari.github.io/src/ontology/index.js",[],{"ruleId":"76","severity":1,"message":"77","line":2,"column":17,"nodeType":"78","messageId":"79","endLine":2,"endColumn":26},{"ruleId":"76","severity":1,"message":"80","line":2,"column":38,"nodeType":"78","messageId":"79","endLine":2,"endColumn":47},{"ruleId":"76","severity":1,"message":"81","line":6,"column":10,"nodeType":"78","messageId":"