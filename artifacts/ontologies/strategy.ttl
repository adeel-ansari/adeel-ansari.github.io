@prefix : <https://adeel-ansari.github.io/ontologies/strategy#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@base <https://adeel-ansari.github.io/ontologies/strategy> .

# Generated from src/ontology/strategy.json by scripts/build-ontology-ttl.js.
# Edit the JSON file and re-run `npm run build:ontology` rather than editing this file.

<https://adeel-ansari.github.io/ontologies/strategy> rdf:type owl:Ontology ;
    dcterms:title "Strategy Ontology (Playing to Win)"@en ;
    dcterms:description "An ontology of Roger Martin's strategic choice cascade from 'Playing to Win'. A strategy is modelled as five linked choices (winning aspiration, where to play, how to win, must-have capabilities and enabling management systems) so that an organization's activities, measures and resources can be traced back to the choices they support."@en ;
    dcterms:bibliographicCitation "Lafley, A. G., and Roger L. Martin. Playing to Win: How Strategy Really Works. Harvard Business Review Press, 2013."@en ;
    owl:versionInfo "1.0.0" .

dcterms:title rdf:type owl:AnnotationProperty .
dcterms:description rdf:type owl:AnnotationProperty .
dcterms:bibliographicCitation rdf:type owl:AnnotationProperty .

#################################################################
#    Classes
#################################################################

:Strategy rdf:type owl:Class ;
    rdfs:label "Strategy"@en ;
    dcterms:description "In 'Playing to Win', strategy is defined as an integrated set of choices that uniquely positions the firm in its industry so as to create sustainable advantage and superior value relative to the competition. A strategy is made of the five cascade choices, and strategies nest: the choices at one level of the organization set the context for the level below."@en ;
    dcterms:bibliographicCitation "Lafley, A. G., and Roger L. Martin. Playing to Win: How Strategy Really Works. Harvard Business Review Press, 2013."@en .

:WinningAspiration rdf:type owl:Class ;
    rdfs:label "Winning Aspiration"@en ;
    rdfs:comment "Strategic choice cascade, step 1: What is our winning aspiration?"@en ;
    dcterms:description "The purpose of the organization and its motivating aspiration. It defines what winning means, who the organization is winning with (its most important consumers and customers) and who it is winning against (the very best competitors)."@en ;
    dcterms:bibliographicCitation "Lafley, A. G., and Roger L. Martin. Playing to Win: How Strategy Really Works. Harvard Business Review Press, 2013."@en .

:WhereToPlay rdf:type owl:Class ;
    rdfs:label "Where to Play"@en ;
    rdfs:comment "Strategic choice cascade, step 2: Where will we play?"@en ;
    dcterms:description "The playing field on which the organization will achieve its aspiration. It is set by choices on five dimensions: geography, product type, consumer segment, distribution channel and vertical stage of production."@en ;
    dcterms:bibliographicCitation "Lafley, A. G., and Roger L. Martin. Playing to Win: How Strategy Really Works. Harvard Business Review Press, 2013."@en .

:Geography rdf:type owl:Class ;
    rdfs:label "Geography"@en ;
    dcterms:description "The countries or regions in which the organization will compete."@en ;
    dcterms:bibliographicCitation "Lafley, A. G., and Roger L. Martin. Playing to Win: How Strategy Really Works. Harvard Business Review Press, 2013."@en .

:ProductType rdf:type owl:Class ;
    rdfs:label "Product Type"@en ;
    dcterms:description "The kinds of products and services offered by the organization."@en ;
    dcterms:bibliographicCitation "Lafley, A. G., and Roger L. Martin. Playing to Win: How Strategy Really Works. Harvard Business Review Press, 2013."@en .

:ConsumerSegment rdf:type owl:Class ;
    rdfs:label "Consumer Segment"@en ;
    dcterms:description "A group of consumers the organization chooses to serve, defined by shared characteristics, the price tier they buy in and the needs they want met. Segmenting consumers lets the organization understand them better and target each group through product development, marketing and pricing."@en ;
    dcterms:bibliographicCitation "Lafley, A. G., and Roger L. Martin. Playing to Win: How Strategy Really Works. Harvard Business Review Press, 2013."@en .

:CustomerSegment rdf:type owl:Class ;
    rdfs:label "Customer Segment"@en ;
    dcterms:description "A group of customers (the people or organizations who buy, such as retailers or distributors) the organization will target through pricing, product features and marketing. The customer is not always the consumer, so this segmentation focuses on who purchases the product or service."@en ;
    dcterms:bibliographicCitation "Lafley, A. G., and Roger L. Martin. Playing to Win: How Strategy Really Works. Harvard Business Review Press, 2013."@en .

:DistributionChannel rdf:type owl:Class ;
    rdfs:label "Distribution Channel"@en ;
    dcterms:description "A route through which the organization reaches its customers and consumers, such as mass retail, specialty retail, direct-to-consumer or e-commerce."@en ;
    dcterms:bibliographicCitation "Lafley, A. G., and Roger L. Martin. Playing to Win: How Strategy Really Works. Harvard Business Review Press, 2013."@en .

:VerticalStageOfProduction rdf:type owl:Class ;
    rdfs:label "Vertical Stage of Production"@en ;
    dcterms:description "The stages of production the organization will engage in, where along the value chain, and how broadly or narrowly."@en ;
    dcterms:bibliographicCitation "Lafley, A. G., and Roger L. Martin. Playing to Win: How Strategy Really Works. Harvard Business Review Press, 2013."@en .

:HowToWin rdf:type owl:Class ;
    rdfs:label "How to Win"@en ;
    rdfs:comment "Strategic choice cascade, step 3: How will we win where we have chosen to play?"@en ;
    dcterms:description "The way the organization will win on its chosen playing field. There are two generic ways to win: cost leadership and differentiation. Either way, the goal is a sustainably greater margin between revenue and cost than competitors can match. Where-to-play and how-to-win choices must be made together and reinforce each other."@en ;
    dcterms:bibliographicCitation "Lafley, A. G., and Roger L. Martin. Playing to Win: How Strategy Really Works. Harvard Business Review Press, 2013."@en .

:CompetitiveAdvantage rdf:type owl:Class ;
    rdfs:label "Competitive Advantage"@en ;
    dcterms:description "One or more factors that allow an organization to deliver superior value to consumers and customers, or deliver equal value at a lower cost, compared with its competitors."@en ;
    dcterms:bibliographicCitation "Lafley, A. G., and Roger L. Martin. Playing to Win: How Strategy Really Works. Harvard Business Review Press, 2013."@en .

:CostLeadership rdf:type owl:Class ;
    rdfs:subClassOf :CompetitiveAdvantage ;
    rdfs:label "Cost Leadership"@en ;
    dcterms:description "Winning by having a lower cost structure than competitors, so that the organization earns a higher margin at the same price or can price lower while remaining profitable."@en ;
    dcterms:bibliographicCitation "Lafley, A. G., and Roger L. Martin. Playing to Win: How Strategy Really Works. Harvard Business Review Press, 2013."@en .

:Differentiation rdf:type owl:Class ;
    rdfs:subClassOf :CompetitiveAdvantage ;
    rdfs:label "Differentiation"@en ;
    dcterms:description "Winning by offering products or services that consumers and customers perceive as uniquely valuable, allowing the organization to command a higher price than competitors."@en ;
    dcterms:bibliographicCitation "Lafley, A. G., and Roger L. Martin. Playing to Win: How Strategy Really Works. Harvard Business Review Press, 2013."@en .

:ValueProposition rdf:type owl:Class ;
    rdfs:label "Value Proposition"@en ;
    dcterms:description "The value an organization promises to deliver to its consumers and customers if they buy its products or services: the reason they should choose it over the alternatives."@en ;
    dcterms:bibliographicCitation "Lafley, A. G., and Roger L. Martin. Playing to Win: How Strategy Really Works. Harvard Business Review Press, 2013."@en .

:CoreCapability rdf:type owl:Class ;
    rdfs:label "Must-Have Capability"@en ;
    rdfs:comment "Strategic choice cascade, step 4: What capabilities must be in place to win?"@en ;
    dcterms:description "A core capability the organization must have to deliver on its where-to-play and how-to-win choices. Together the capabilities form a reinforcing activity system that is distinctive from competitors."@en ;
    dcterms:bibliographicCitation "Lafley, A. G., and Roger L. Martin. Playing to Win: How Strategy Really Works. Harvard Business Review Press, 2013."@en .

:ActivitySystem rdf:type owl:Class ;
    rdfs:label "Activity System"@en ;
    dcterms:description "The organization's core capabilities operating as a system of reinforcing activities. Because this system is uniquely different from competitors, it is essentially the organization's competitive advantage. It is composed of the core capabilities, the relationships between them and the activities that support them."@en ;
    dcterms:bibliographicCitation "Lafley, A. G., and Roger L. Martin. Playing to Win: How Strategy Really Works. Harvard Business Review Press, 2013."@en .

:Activity rdf:type owl:Class ;
    rdfs:label "Activity"@en ;
    dcterms:description "A subordinate node in an activity system: a specific activity that supports one or more core capabilities."@en ;
    dcterms:bibliographicCitation "Lafley, A. G., and Roger L. Martin. Playing to Win: How Strategy Really Works. Harvard Business Review Press, 2013."@en .

:ManagementSystem rdf:type owl:Class ;
    rdfs:label "Management System"@en ;
    rdfs:comment "Strategic choice cascade, step 5: What management systems are required?"@en ;
    dcterms:description "A system, structure or process that builds and sustains the must-have capabilities and supports the strategic choices, such as strategy reviews, budgeting, talent development and measurement."@en ;
    dcterms:bibliographicCitation "Lafley, A. G., and Roger L. Martin. Playing to Win: How Strategy Really Works. Harvard Business Review Press, 2013."@en .

:StrategyDialogue rdf:type owl:Class ;
    rdfs:subClassOf :ManagementSystem ;
    rdfs:label "Strategy Dialogue"@en ;
    dcterms:description "A recurring review in which leaders revisit, test and refine the strategic choices, for example an annual strategy review between a business unit and corporate leadership."@en ;
    dcterms:bibliographicCitation "Lafley, A. G., and Roger L. Martin. Playing to Win: How Strategy Really Works. Harvard Business Review Press, 2013."@en .

:ResourceAllocationSystem rdf:type owl:Class ;
    rdfs:subClassOf :ManagementSystem ;
    rdfs:label "Resource Allocation System"@en ;
    dcterms:description "The budgeting and investment processes that direct money, people and time toward the chosen playing fields and capabilities, and away from those the strategy rules out."@en ;
    dcterms:bibliographicCitation "Lafley, A. G., and Roger L. Martin. Playing to Win: How Strategy Really Works. Harvard Business Review Press, 2013."@en .

:TalentDevelopmentSystem rdf:type owl:Class ;
    rdfs:subClassOf :ManagementSystem ;
    rdfs:label "Talent Development System"@en ;
    dcterms:description "The hiring, training, career development and incentive systems that build the people capabilities the strategy depends on."@en ;
    dcterms:bibliographicCitation "Lafley, A. G., and Roger L. Martin. Playing to Win: How Strategy Really Works. Harvard Business Review Press, 2013."@en .

:Measure rdf:type owl:Class ;
    rdfs:label "Measure"@en ;
    dcterms:description "A measure of success used to track whether the strategy is working, such as market share, consumer preference or cost position. Measures make the winning aspiration concrete and show whether capabilities are being built."@en ;
    dcterms:bibliographicCitation "Lafley, A. G., and Roger L. Martin. Playing to Win: How Strategy Really Works. Harvard Business Review Press, 2013."@en .

<http://www.w3.org/ns/org#Organization> rdf:type owl:Class ;
    rdfs:label "Organization"@en ;
    dcterms:description "An organization, as defined by the W3C Organization Ontology, that makes and follows strategic choices."@en .

:Competitor rdf:type owl:Class ;
    rdfs:subClassOf <http://www.w3.org/ns/org#Organization> ;
    rdfs:label "Competitor"@en ;
    dcterms:description "An organization that competes for the same consumers and customers. The winning aspiration names the best competitors the organization intends to beat."@en ;
    dcterms:bibliographicCitation "Lafley, A. G., and Roger L. Martin. Playing to Win: How Strategy Really Works. Harvard Business Review Press, 2013."@en .

:Consumer rdf:type owl:Class ;
    rdfs:label "Consumer"@en ;
    dcterms:description "A person or organization that actually uses the goods or services offered by the organization."@en ;
    dcterms:bibliographicCitation "Lafley, A. G., and Roger L. Martin. Playing to Win: How Strategy Really Works. Harvard Business Review Press, 2013."@en .

:Customer rdf:type owl:Class ;
    rdfs:label "Customer"@en ;
    dcterms:description "The person or organization that buys the goods or services from the organization. The customer is not always the consumer of the product or service."@en ;
    dcterms:bibliographicCitation "Lafley, A. G., and Roger L. Martin. Playing to Win: How Strategy Really Works. Harvard Business Review Press, 2013."@en .

:InternalCustomer rdf:type owl:Class ;
    rdfs:subClassOf :Customer ;
    rdfs:label "Internal Customer"@en ;
    dcterms:description "An employee or unit within the organization that depends on another part of the organization for goods or services."@en ;
    dcterms:bibliographicCitation "Lafley, A. G., and Roger L. Martin. Playing to Win: How Strategy Really Works. Harvard Business Review Press, 2013."@en .

:ExternalCustomer rdf:type owl:Class ;
    rdfs:subClassOf :Customer ;
    rdfs:label "External Customer"@en ;
    dcterms:description "A customer who purchases the organization's products or services and is not part of the organization."@en ;
    dcterms:bibliographicCitation "Lafley, A. G., and Roger L. Martin. Playing to Win: How Strategy Really Works. Harvard Business Review Press, 2013."@en .

#################################################################
#    Object properties
#################################################################

:Organization.strategy rdf:type owl:ObjectProperty ;
    rdfs:domain <http://www.w3.org/ns/org#Organization> ;
    rdfs:range :Strategy ;
    rdfs:label "Organization.strategy"@en ;
    dcterms:description "The strategy the organization has chosen."@en .

:Organization.activitySystem rdf:type owl:ObjectProperty ;
    rdfs:domain <http://www.w3.org/ns/org#Organization> ;
    rdfs:range :ActivitySystem ;
    rdfs:label "Organization.activitySystem"@en ;
    dcterms:description "The activity system the organization has built to deliver its strategy."@en .

:Strategy.winningAspiration rdf:type owl:ObjectProperty ;
    rdfs:domain :Strategy ;
    rdfs:range :WinningAspiration ;
    rdfs:label "Strategy.winningAspiration"@en ;
    dcterms:description "Cascade choice 1: the winning aspiration that is part of the strategy."@en .

:Strategy.whereToPlay rdf:type owl:ObjectProperty ;
    rdfs:domain :Strategy ;
    rdfs:range :WhereToPlay ;
    rdfs:label "Strategy.whereToPlay"@en ;
    dcterms:description "Cascade choice 2: the where-to-play choice that is part of the strategy."@en .

:Strategy.howToWin rdf:type owl:ObjectProperty ;
    rdfs:domain :Strategy ;
    rdfs:range :HowToWin ;
    rdfs:label "Strategy.howToWin"@en ;
    dcterms:description "Cascade choice 3: the how-to-win choice that is part of the strategy."@en .

:Strategy.coreCapability rdf:type owl:ObjectProperty ;
    rdfs:domain :Strategy ;
    rdfs:range :CoreCapability ;
    rdfs:label "Strategy.coreCapability"@en ;
    dcterms:description "Cascade choice 4: the must-have capabilities required for this strategy."@en .

:Strategy.managementSystem rdf:type owl:ObjectProperty ;
    rdfs:domain :Strategy ;
    rdfs:range :ManagementSystem ;
    rdfs:label "Strategy.managementSystem"@en ;
    dcterms:description "Cascade choice 5: the management systems selected to support the strategy."@en .

:Strategy.parentStrategy rdf:type owl:ObjectProperty ;
    rdfs:domain :Strategy ;
    rdfs:range :Strategy ;
    rdfs:label "Strategy.parentStrategy"@en ;
    dcterms:description "The strategy one level up in the organization (for example corporate above business unit, business unit above brand). The parent's where-to-play and how-to-win choices set the context and aspiration for this strategy, which is how choices cascade through the organization."@en .

:WinningAspiration.consumerContext rdf:type owl:ObjectProperty ;
    rdfs:domain :WinningAspiration ;
    rdfs:range :ConsumerSegment ;
    rdfs:label "WinningAspiration.consumerContext"@en ;
    dcterms:description "Who the organization is focused on winning with: its most important consumers."@en .

:WinningAspiration.customerContext rdf:type owl:ObjectProperty ;
    rdfs:domain :WinningAspiration ;
    rdfs:range :CustomerSegment ;
    rdfs:label "WinningAspiration.customerContext"@en ;
    dcterms:description "Who the organization is focused on winning with among customers, such as the retail or channel partners that buy from it."@en .

:WinningAspiration.competitorContext rdf:type owl:ObjectProperty ;
    rdfs:domain :WinningAspiration ;
    rdfs:range :Competitor ;
    rdfs:label "WinningAspiration.competitorContext"@en ;
    dcterms:description "Who the organization is focused on winning against: the very best competitors."@en .

:WinningAspiration.successMeasure rdf:type owl:ObjectProperty ;
    rdfs:domain :WinningAspiration ;
    rdfs:range :Measure ;
    rdfs:label "WinningAspiration.successMeasure"@en ;
    dcterms:description "The measures that show whether the organization is winning."@en .

:WhereToPlay.servesAspiration rdf:type owl:ObjectProperty ;
    rdfs:domain :WhereToPlay ;
    rdfs:range :WinningAspiration ;
    rdfs:label "WhereToPlay.servesAspiration"@en ;
    dcterms:description "The winning aspiration this playing field is chosen to achieve."@en .

:WhereToPlay.geography rdf:type owl:ObjectProperty ;
    rdfs:domain :WhereToPlay ;
    rdfs:range :Geography ;
    rdfs:label "WhereToPlay.geography"@en ;
    dcterms:description "In what countries or regions will you seek to compete?"@en .

:WhereToPlay.productType rdf:type owl:ObjectProperty ;
    rdfs:domain :WhereToPlay ;
    rdfs:range :ProductType ;
    rdfs:label "WhereToPlay.productType"@en ;
    dcterms:description "What types of products and services will you offer?"@en .

:WhereToPlay.consumerSegment rdf:type owl:ObjectProperty ;
    rdfs:domain :WhereToPlay ;
    rdfs:range :ConsumerSegment ;
    rdfs:label "WhereToPlay.consumerSegment"@en ;
    dcterms:description "What groups of consumers will you target? In which price tier? Meeting which consumer needs?"@en .

:WhereToPlay.distributionChannel rdf:type owl:ObjectProperty ;
    rdfs:domain :WhereToPlay ;
    rdfs:range :DistributionChannel ;
    rdfs:label "WhereToPlay.distributionChannel"@en ;
    dcterms:description "How will you reach your customers? What channels will you use?"@en .

:WhereToPlay.verticalStageOfProduction rdf:type owl:ObjectProperty ;
    rdfs:domain :WhereToPlay ;
    rdfs:range :VerticalStageOfProduction ;
    rdfs:label "WhereToPlay.verticalStageOfProduction"@en ;
    dcterms:description "In what stages of production will you engage? Where along the value chain? How broadly or narrowly?"@en .

:HowToWin.appliesTo rdf:type owl:ObjectProperty ;
    rdfs:domain :HowToWin ;
    rdfs:range :WhereToPlay ;
    rdfs:label "HowToWin.appliesTo"@en ;
    dcterms:description "The playing field on which this way of winning applies. A how-to-win choice only makes sense in the context of a where-to-play choice."@en .

:HowToWin.competitiveAdvantage rdf:type owl:ObjectProperty ;
    rdfs:domain :HowToWin ;
    rdfs:range :CompetitiveAdvantage ;
    rdfs:label "HowToWin.competitiveAdvantage"@en ;
    dcterms:description "The competitive advantage (cost leadership or differentiation) the organization will build."@en .

:HowToWin.valueProposition rdf:type owl:ObjectProperty ;
    rdfs:domain :HowToWin ;
    rdfs:range :ValueProposition ;
    rdfs:label "HowToWin.valueProposition"@en ;
    dcterms:description "The value proposition offered to consumers and customers."@en .

:ValueProposition.consumerSegment rdf:type owl:ObjectProperty ;
    rdfs:domain :ValueProposition ;
    rdfs:range :ConsumerSegment ;
    rdfs:label "ValueProposition.consumerSegment"@en ;
    dcterms:description "The consumer segment the value proposition is designed for."@en .

:CoreCapability.enables rdf:type owl:ObjectProperty ;
    rdfs:domain :CoreCapability ;
    rdfs:range :HowToWin ;
    rdfs:label "CoreCapability.enables"@en ;
    dcterms:description "The how-to-win choice this capability makes possible."@en .

:CoreCapability.supportingActivity rdf:type owl:ObjectProperty ;
    rdfs:domain :CoreCapability ;
    rdfs:range :Activity ;
    rdfs:label "CoreCapability.supportingActivity"@en ;
    dcterms:description "The activities that support the core capability."@en .

:CoreCapability.reinforcingRelationship rdf:type owl:ObjectProperty ;
    rdfs:domain :CoreCapability ;
    rdfs:range :CoreCapability ;
    rdfs:label "CoreCapability.reinforcingRelationship"@en ;
    dcterms:description "Links core capabilities within the same organization that strengthen one another."@en .

:CoreCapability.reinforcingRod rdf:type owl:ObjectProperty ;
    rdfs:domain :CoreCapability ;
    rdfs:range :CoreCapability ;
    rdfs:label "CoreCapability.reinforcingRod"@en ;
    dcterms:description "Links core capabilities across different organizations or levels, for example a business unit drawing on a corporate capability."@en .

:ActivitySystem.coreCapability rdf:type owl:ObjectProperty ;
    rdfs:domain :ActivitySystem ;
    rdfs:range :CoreCapability ;
    rdfs:label "ActivitySystem.coreCapability"@en ;
    dcterms:description "The core capabilities that make up the activity system."@en .

:ManagementSystem.supportsCapability rdf:type owl:ObjectProperty ;
    rdfs:domain :ManagementSystem ;
    rdfs:range :CoreCapability ;
    rdfs:label "ManagementSystem.supportsCapability"@en ;
    dcterms:description "The must-have capability this management system builds or sustains."@en .

:ManagementSystem.measure rdf:type owl:ObjectProperty ;
    rdfs:domain :ManagementSystem ;
    rdfs:range :Measure ;
    rdfs:label "ManagementSystem.measure"@en ;
    dcterms:description "The measures this management system tracks."@en .

:Consumer.consumerSegment rdf:type owl:ObjectProperty ;
    rdfs:domain :Consumer ;
    rdfs:range :ConsumerSegment ;
    rdfs:label "Consumer.consumerSegment"@en ;
    dcterms:description "The consumer segment this consumer belongs to."@en .

:Customer.customerSegment rdf:type owl:ObjectProperty ;
    rdfs:domain :Customer ;
    rdfs:range :CustomerSegment ;
    rdfs:label "Customer.customerSegment"@en ;
    dcterms:description "The customer segment this customer belongs to."@en .

#################################################################
#    Datatype properties
#################################################################

:Strategy.title rdf:type owl:DatatypeProperty ;
    rdfs:domain :Strategy ;
    rdfs:range xsd:string ;
    rdfs:label "Strategy.title"@en ;
    dcterms:description "Human-readable title for the strategy."@en .

:Strategy.status rdf:type owl:DatatypeProperty ;
    rdfs:domain :Strategy ;
    rdfs:range xsd:string ;
    rdfs:label "Strategy.status"@en ;
    dcterms:description "Whether the strategy is a draft, in active use, or no longer in use."@en .

:Strategy.startDate rdf:type owl:DatatypeProperty ;
    rdfs:domain :Strategy ;
    rdfs:range xsd:dateTime ;
    rdfs:label "Strategy.startDate"@en ;
    dcterms:description "When the organization started following this strategy."@en .

:Strategy.endDate rdf:type owl:DatatypeProperty ;
    rdfs:domain :Strategy ;
    rdfs:range xsd:dateTime ;
    rdfs:label "Strategy.endDate"@en ;
    dcterms:description "When the organization stopped following this strategy."@en .

:WinningAspiration.aspirationStatement rdf:type owl:DatatypeProperty ;
    rdfs:domain :WinningAspiration ;
    rdfs:range xsd:string ;
    rdfs:label "WinningAspiration.aspirationStatement"@en ;
    dcterms:description "A statement of what the organization is trying to achieve: what winning looks like."@en .

:WhereToPlay.statement rdf:type owl:DatatypeProperty ;
    rdfs:domain :WhereToPlay ;
    rdfs:range xsd:string ;
    rdfs:label "WhereToPlay.statement"@en ;
    dcterms:description "A short statement of the chosen playing field."@en .

:WhereToPlay.excludedOption rdf:type owl:DatatypeProperty ;
    rdfs:domain :WhereToPlay ;
    rdfs:range xsd:string ;
    rdfs:label "WhereToPlay.excludedOption"@en ;
    dcterms:description "A playing field the organization has explicitly decided not to play in. Choosing where not to play is as important as choosing where to play."@en .

:HowToWin.statement rdf:type owl:DatatypeProperty ;
    rdfs:domain :HowToWin ;
    rdfs:range xsd:string ;
    rdfs:label "HowToWin.statement"@en ;
    dcterms:description "A short statement of how the organization will win."@en .

:ValueProposition.statement rdf:type owl:DatatypeProperty ;
    rdfs:domain :ValueProposition ;
    rdfs:range xsd:string ;
    rdfs:label "ValueProposition.statement"@en ;
    dcterms:description "The promise made to consumers and customers."@en .

:ConsumerSegment.priceTier rdf:type owl:DatatypeProperty ;
    rdfs:domain :ConsumerSegment ;
    rdfs:range xsd:string ;
    rdfs:label "ConsumerSegment.priceTier"@en ;
    dcterms:description "The price tier the segment buys in, for example value, mid-tier or premium."@en .

:ConsumerSegment.need rdf:type owl:DatatypeProperty ;
    rdfs:domain :ConsumerSegment ;
    rdfs:range xsd:string ;
    rdfs:label "ConsumerSegment.need"@en ;
    dcterms:description "The consumer need the organization will meet for this segment."@en .

:CoreCapability.statement rdf:type owl:DatatypeProperty ;
    rdfs:domain :CoreCapability ;
    rdfs:range xsd:string ;
    rdfs:label "CoreCapability.statement"@en ;
    dcterms:description "What the capability is and why it is distinctive."@en .

:ManagementSystem.statement rdf:type owl:DatatypeProperty ;
    rdfs:domain :ManagementSystem ;
    rdfs:range xsd:string ;
    rdfs:label "ManagementSystem.statement"@en ;
    dcterms:description "What the management system does."@en .

:ManagementSystem.cadence rdf:type owl:DatatypeProperty ;
    rdfs:domain :ManagementSystem ;
    rdfs:range xsd:string ;
    rdfs:label "ManagementSystem.cadence"@en ;
    dcterms:description "How often the system runs, for example quarterly or annually."@en .

:Measure.target rdf:type owl:DatatypeProperty ;
    rdfs:domain :Measure ;
    rdfs:range xsd:string ;
    rdfs:label "Measure.target"@en ;
    dcterms:description "The target value or threshold that counts as success."@en .
