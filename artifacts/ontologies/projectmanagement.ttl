@prefix : <https://adeel-ansari.github.io/ontologies/project-management#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@base <https://adeel-ansari.github.io/ontologies/project-management> .

# Generated by scripts/build-ontology-ttl.js from the source JSON.
# Edit the JSON and re-run `npm run build:ontology` rather than editing this file.

<https://adeel-ansari.github.io/ontologies/project-management> rdf:type owl:Ontology ;
    dcterms:title "Agile Project Management Ontology"@en ;
    dcterms:description "An ontology of core agile project management concepts: how work is organised from high-level themes and epics down to individual stories and tasks, and how delivery cadence is managed through sprints and backlogs."@en ;
    dcterms:bibliographicCitation "Cohn, M. User Stories Applied: For Agile Software Development. Addison-Wesley, 2004. / Schwaber, K. and Sutherland, J. The Scrum Guide. scrum.org, 2020."@en ;
    owl:versionInfo "1.0.0" .

dcterms:title rdf:type owl:AnnotationProperty .
dcterms:description rdf:type owl:AnnotationProperty .
dcterms:bibliographicCitation rdf:type owl:AnnotationProperty .

#################################################################
#    Classes
#################################################################

:Theme rdf:type owl:Class ;
    rdfs:label "Theme"@en ;
    rdfs:comment "Hierarchy step 1: What strategic area of investment are we committing to?"@en ;
    dcterms:description "A high-level grouping of related epics that together serve a significant business or product objective. Themes help the team and stakeholders understand the strategic direction of the backlog without getting into the detail of individual stories."@en ;
    dcterms:bibliographicCitation "Cohn, M. User Stories Applied: For Agile Software Development. Addison-Wesley, 2004. / Schwaber, K. and Sutherland, J. The Scrum Guide. scrum.org, 2020."@en .

:Release rdf:type owl:Class ;
    rdfs:label "Release"@en ;
    dcterms:description "A versioned deployment of product increments delivered to users. Releases group completed epics and stories into a coherent unit of value. Release planning aligns the team on what will be delivered by when."@en ;
    dcterms:bibliographicCitation "Cohn, M. User Stories Applied: For Agile Software Development. Addison-Wesley, 2004. / Schwaber, K. and Sutherland, J. The Scrum Guide. scrum.org, 2020."@en .

:Epic rdf:type owl:Class ;
    rdfs:label "Epic"@en ;
    rdfs:comment "Hierarchy step 2: What significant capability will we build?"@en ;
    dcterms:description "A large body of work that represents a significant product capability or business requirement. Epics are too broad to deliver in a single sprint and are progressively refined into user stories as understanding grows."@en ;
    dcterms:bibliographicCitation "Cohn, M. User Stories Applied: For Agile Software Development. Addison-Wesley, 2004. / Schwaber, K. and Sutherland, J. The Scrum Guide. scrum.org, 2020."@en .

:Story rdf:type owl:Class ;
    rdfs:label "User Story"@en ;
    rdfs:comment "Hierarchy step 3: What specific user need will we address?"@en ;
    dcterms:description "A short, simple description of a feature or capability told from the perspective of the user who wants it. User stories follow the form 'As a [persona], I want [goal] so that [benefit].' They are the primary unit of work planned and delivered within a sprint."@en ;
    dcterms:bibliographicCitation "Cohn, M. User Stories Applied: For Agile Software Development. Addison-Wesley, 2004. / Schwaber, K. and Sutherland, J. The Scrum Guide. scrum.org, 2020."@en .

:Sprint rdf:type owl:Class ;
    rdfs:label "Sprint"@en ;
    dcterms:description "A fixed-length iteration, typically one to four weeks, during which the team selects a set of stories from the backlog and commits to achieving a sprint goal. Each sprint ends with a potentially shippable product increment."@en ;
    dcterms:bibliographicCitation "Cohn, M. User Stories Applied: For Agile Software Development. Addison-Wesley, 2004. / Schwaber, K. and Sutherland, J. The Scrum Guide. scrum.org, 2020."@en .

:Task rdf:type owl:Class ;
    rdfs:label "Task"@en ;
    rdfs:comment "Hierarchy step 4: What technical work is needed to implement the story?"@en ;
    dcterms:description "A specific piece of technical or non-technical work required to implement a user story. Tasks are estimated in hours, owned by individual team members, and tracked on the sprint board. A story is not done until all its tasks are done."@en ;
    dcterms:bibliographicCitation "Cohn, M. User Stories Applied: For Agile Software Development. Addison-Wesley, 2004. / Schwaber, K. and Sutherland, J. The Scrum Guide. scrum.org, 2020."@en .

:Backlog rdf:type owl:Class ;
    rdfs:label "Backlog"@en ;
    dcterms:description "An ordered, prioritised list of work items. The product backlog captures all known future work in priority order. The sprint backlog contains the stories the team has committed to for the current sprint, plus the tasks needed to deliver them."@en ;
    dcterms:bibliographicCitation "Cohn, M. User Stories Applied: For Agile Software Development. Addison-Wesley, 2004. / Schwaber, K. and Sutherland, J. The Scrum Guide. scrum.org, 2020."@en .

:AcceptanceCriteria rdf:type owl:Class ;
    rdfs:label "Acceptance Criteria"@en ;
    dcterms:description "A set of conditions a user story must satisfy before it is considered complete and accepted by the product owner. Acceptance criteria make the requirements explicit and testable, removing ambiguity about what 'done' means for a given story."@en ;
    dcterms:bibliographicCitation "Cohn, M. User Stories Applied: For Agile Software Development. Addison-Wesley, 2004. / Schwaber, K. and Sutherland, J. The Scrum Guide. scrum.org, 2020."@en .

:DefinitionOfDone rdf:type owl:Class ;
    rdfs:label "Definition of Done"@en ;
    dcterms:description "A shared checklist of conditions that every work item must meet before it can be called complete, such as code reviewed, unit tested, integrated, and deployed to staging. The definition of done is owned by the team and applied consistently across all stories."@en ;
    dcterms:bibliographicCitation "Cohn, M. User Stories Applied: For Agile Software Development. Addison-Wesley, 2004. / Schwaber, K. and Sutherland, J. The Scrum Guide. scrum.org, 2020."@en .

:StoryPoint rdf:type owl:Class ;
    rdfs:label "Story Point"@en ;
    dcterms:description "A relative unit of effort used to estimate the work required to implement a user story. Story points account for complexity, volume and uncertainty as a whole, rather than estimating in hours. They enable velocity tracking across sprints."@en ;
    dcterms:bibliographicCitation "Cohn, M. User Stories Applied: For Agile Software Development. Addison-Wesley, 2004. / Schwaber, K. and Sutherland, J. The Scrum Guide. scrum.org, 2020."@en .

:Persona rdf:type owl:Class ;
    rdfs:label "Persona"@en ;
    dcterms:description "A fictional user archetype representing a real user type, their goals, behaviours and pain points. Personas are used in the '[As a]' part of user stories to ground requirements in real user needs and prevent feature development driven by internal assumptions."@en ;
    dcterms:bibliographicCitation "Cohn, M. User Stories Applied: For Agile Software Development. Addison-Wesley, 2004. / Schwaber, K. and Sutherland, J. The Scrum Guide. scrum.org, 2020."@en .

:ProductOwner rdf:type owl:Class ;
    rdfs:label "Product Owner"@en ;
    dcterms:description "The team member responsible for maximising the value of the product by defining and prioritising the product backlog. The product owner represents the business and stakeholders, writes or approves user stories, and accepts completed work at the end of each sprint."@en ;
    dcterms:bibliographicCitation "Cohn, M. User Stories Applied: For Agile Software Development. Addison-Wesley, 2004. / Schwaber, K. and Sutherland, J. The Scrum Guide. scrum.org, 2020."@en .

:ScrumMaster rdf:type owl:Class ;
    rdfs:label "Scrum Master"@en ;
    dcterms:description "The servant-leader responsible for helping the team follow agile principles, removing impediments, and facilitating agile ceremonies (sprint planning, daily stand-up, retrospective, review). The scrum master does not manage the team but coaches them toward self-organisation."@en ;
    dcterms:bibliographicCitation "Cohn, M. User Stories Applied: For Agile Software Development. Addison-Wesley, 2004. / Schwaber, K. and Sutherland, J. The Scrum Guide. scrum.org, 2020."@en .

#################################################################
#    Object properties
#################################################################

:Theme.containsEpic rdf:type owl:ObjectProperty ;
    rdfs:domain :Theme ;
    rdfs:range :Epic ;
    rdfs:label "Theme.containsEpic"@en ;
    dcterms:description "The epics that belong to this theme."@en .

:Theme.targetedRelease rdf:type owl:ObjectProperty ;
    rdfs:domain :Theme ;
    rdfs:range :Release ;
    rdfs:label "Theme.targetedRelease"@en ;
    dcterms:description "The release this theme is intended to ship in."@en .

:Release.includesEpic rdf:type owl:ObjectProperty ;
    rdfs:domain :Release ;
    rdfs:range :Epic ;
    rdfs:label "Release.includesEpic"@en ;
    dcterms:description "The epics included in this release."@en .

:Epic.partOfTheme rdf:type owl:ObjectProperty ;
    rdfs:domain :Epic ;
    rdfs:range :Theme ;
    rdfs:label "Epic.partOfTheme"@en ;
    dcterms:description "The theme this epic belongs to."@en .

:Epic.targetedRelease rdf:type owl:ObjectProperty ;
    rdfs:domain :Epic ;
    rdfs:range :Release ;
    rdfs:label "Epic.targetedRelease"@en ;
    dcterms:description "The release this epic is planned for."@en .

:Epic.decomposesTo rdf:type owl:ObjectProperty ;
    rdfs:domain :Epic ;
    rdfs:range :Story ;
    rdfs:label "Epic.decomposesTo"@en ;
    dcterms:description "The user stories this epic breaks down into as it is refined."@en .

:Story.partOfEpic rdf:type owl:ObjectProperty ;
    rdfs:domain :Story ;
    rdfs:range :Epic ;
    rdfs:label "Story.partOfEpic"@en ;
    dcterms:description "The epic this story contributes to."@en .

:Story.hasAcceptanceCriteria rdf:type owl:ObjectProperty ;
    rdfs:domain :Story ;
    rdfs:range :AcceptanceCriteria ;
    rdfs:label "Story.hasAcceptanceCriteria"@en ;
    dcterms:description "The acceptance criteria that define when this story is done."@en .

:Story.pointEstimate rdf:type owl:ObjectProperty ;
    rdfs:domain :Story ;
    rdfs:range :StoryPoint ;
    rdfs:label "Story.pointEstimate"@en ;
    dcterms:description "The story point estimate for this story."@en .

:Story.writtenFor rdf:type owl:ObjectProperty ;
    rdfs:domain :Story ;
    rdfs:range :Persona ;
    rdfs:label "Story.writtenFor"@en ;
    dcterms:description "The persona whose need this story addresses (the 'As a' in the story template)."@en .

:Story.scheduledIn rdf:type owl:ObjectProperty ;
    rdfs:domain :Story ;
    rdfs:range :Sprint ;
    rdfs:label "Story.scheduledIn"@en ;
    dcterms:description "The sprint this story is planned for."@en .

:Task.implements rdf:type owl:ObjectProperty ;
    rdfs:domain :Task ;
    rdfs:range :Story ;
    rdfs:label "Task.implements"@en ;
    dcterms:description "The user story this task contributes to implementing."@en .

:Sprint.contains rdf:type owl:ObjectProperty ;
    rdfs:domain :Sprint ;
    rdfs:range :Story ;
    rdfs:label "Sprint.contains"@en ;
    dcterms:description "The user stories the team has committed to for this sprint."@en .

:Sprint.drawsFrom rdf:type owl:ObjectProperty ;
    rdfs:domain :Sprint ;
    rdfs:range :Backlog ;
    rdfs:label "Sprint.drawsFrom"@en ;
    dcterms:description "The backlog from which stories are pulled during sprint planning."@en .

:Backlog.contains rdf:type owl:ObjectProperty ;
    rdfs:domain :Backlog ;
    rdfs:range :Epic ;
    rdfs:label "Backlog.contains"@en ;
    dcterms:description "The epics and stories in this backlog, in priority order."@en .

:Backlog.ownedBy rdf:type owl:ObjectProperty ;
    rdfs:domain :Backlog ;
    rdfs:range :ProductOwner ;
    rdfs:label "Backlog.ownedBy"@en ;
    dcterms:description "The product owner responsible for prioritising this backlog."@en .

:ProductOwner.owns rdf:type owl:ObjectProperty ;
    rdfs:domain :ProductOwner ;
    rdfs:range :Backlog ;
    rdfs:label "ProductOwner.owns"@en ;
    dcterms:description "The backlog this product owner is responsible for."@en .

:ProductOwner.accepts rdf:type owl:ObjectProperty ;
    rdfs:domain :ProductOwner ;
    rdfs:range :Story ;
    rdfs:label "ProductOwner.accepts"@en ;
    dcterms:description "Stories accepted by this product owner as meeting the acceptance criteria."@en .

:ScrumMaster.facilitates rdf:type owl:ObjectProperty ;
    rdfs:domain :ScrumMaster ;
    rdfs:range :Sprint ;
    rdfs:label "ScrumMaster.facilitates"@en ;
    dcterms:description "The sprints this scrum master facilitates."@en .

