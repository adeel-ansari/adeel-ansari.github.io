#################################################################

:Epic.title rdf:type owl:DatatypeProperty ;
    rdfs:domain :Epic ;
    rdfs:range xsd:string ;
    rdfs:label "Epic.title"@en ;
    dcterms:description "A short, descriptive title for the epic."@en .

:Story.storyText rdf:type owl:DatatypeProperty ;
    rdfs:domain :Story ;
    rdfs:range xsd:string ;
    rdfs:label "Story.storyText"@en ;
    dcterms:description "The full story text: 'As a [persona], I want [goal] so that [benefit]'."@en .

:Task.estimatedHours rdf:type owl:DatatypeProperty ;
    rdfs:domain :Task ;
    rdfs:range xsd:decimal ;
    rdfs:label "Task.estimatedHours"@en ;
    dcterms:description "Estimated effort for this task in hours."@en .

:Task.remainingHours rdf:type owl:DatatypeProperty ;
    rdfs:domain :Task ;
    rdfs:range xsd:decimal ;
    rdfs:label "Task.remainingHours"@en ;
    dcterms:description "Remaining effort for this task in hours, updated daily during the sprint."@en .

:Sprint.goal rdf:type owl:DatatypeProperty ;
    rdfs:domain :Sprint ;
    rdfs:range xsd:string ;
    rdfs:label "Sprint.goal"@en ;
    dcterms:description "A short statement of what the team intends to achieve this sprint."@en .

:Sprint.lengthDays rdf:type owl:DatatypeProperty ;
    rdfs:domain :Sprint ;
    rdfs:range xsd:integer ;
    rdfs:label "Sprint.lengthDays"@en ;
    dcterms:description "The length of the sprint in days."@en .

:AcceptanceCriteria.criterion rdf:type owl:DatatypeProperty ;
    rdfs:domain :AcceptanceCriteria ;
    rdfs:range xsd:string ;
    rdfs:label "AcceptanceCriteria.criterion"@en ;
    dcterms:description "A single testable condition the story must satisfy."@en .

:StoryPoint.value rdf:type owl:DatatypeProperty ;
    rdfs:domain :StoryPoint ;
    rdfs:range xsd:integer ;
    rdfs:label "StoryPoint.value"@en ;
    dcterms:description "The point value assigned to the story (e.g. 1, 2, 3, 5, 8, 13 on a Fibonacci scale)."@en .

:Persona.name rdf:type owl:DatatypeProperty ;
    rdfs:domain :Persona ;
    rdfs:range xsd:string ;
    rdfs:label "Persona.name"@en ;
    dcterms:description "The name of the persona (e.g. 'Sarah the Shopper')."@en .

:Persona.goal rdf:type owl:DatatypeProperty ;
    rdfs:domain :Persona ;
    rdfs:range xsd:string ;
    rdfs:label "Persona.goal"@en ;
    dcterms:description "What this persona is trying to achieve."@en .

:Persona.painPoint rdf:type owl:DatatypeProperty ;
    rdfs:domain :Persona ;
    rdfs:range xsd:string ;
    rdfs:label "Persona.painPoint"@en ;
    dcterms:description "A key frustration or problem this persona experiences."@en .
